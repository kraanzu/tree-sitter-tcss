{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "tcss",
  "rules": {
    "stylesheet": {
      "type": "REPEAT",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "SYMBOL",
            "name": "rule_set"
          },
          {
            "type": "SYMBOL",
            "name": "variable_definition"
          }
        ]
      }
    },
    "comment_block": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "/*"
          },
          {
            "type": "PATTERN",
            "value": "[^*]*\\*+([^/*][^*]*\\*+)*"
          },
          {
            "type": "STRING",
            "value": "/"
          }
        ]
      }
    },
    "comment_line": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "# "
          },
          {
            "type": "PATTERN",
            "value": ".*"
          }
        ]
      }
    },
    "selectors": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "selector"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SEQ",
            "members": [
              {
                "type": "STRING",
                "value": ","
              },
              {
                "type": "SYMBOL",
                "name": "selector"
              }
            ]
          }
        }
      ]
    },
    "selector": {
      "type": "PREC_LEFT",
      "value": 0,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "SYMBOL",
            "name": "_selector_unit"
          },
          {
            "type": "REPEAT",
            "content": {
              "type": "CHOICE",
              "members": [
                {
                  "type": "SEQ",
                  "members": [
                    {
                      "type": "SYMBOL",
                      "name": "combinator"
                    },
                    {
                      "type": "SYMBOL",
                      "name": "_selector_unit"
                    }
                  ]
                },
                {
                  "type": "SYMBOL",
                  "name": "_selector_unit"
                }
              ]
            }
          }
        ]
      }
    },
    "_selector_unit": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "wildcard_selector"
        },
        {
          "type": "SYMBOL",
          "name": "nesting_selector"
        },
        {
          "type": "SYMBOL",
          "name": "class_selector"
        },
        {
          "type": "SYMBOL",
          "name": "id_selector"
        },
        {
          "type": "SYMBOL",
          "name": "pseudo_class_selector"
        },
        {
          "type": "SYMBOL",
          "name": "widget_selector"
        }
      ]
    },
    "wildcard_selector": {
      "type": "STRING",
      "value": "*"
    },
    "nesting_selector": {
      "type": "STRING",
      "value": "&"
    },
    "class_selector": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "."
        },
        {
          "type": "SYMBOL",
          "name": "class_name"
        }
      ]
    },
    "id_selector": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "#"
        },
        {
          "type": "SYMBOL",
          "name": "id_name"
        }
      ]
    },
    "class_name": {
      "type": "PATTERN",
      "value": "[-a-zA-Z_][-a-zA-Z0-9_]*"
    },
    "id_name": {
      "type": "PATTERN",
      "value": "[-a-zA-Z0-9_]+"
    },
    "pseudo_class_selector": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": ":"
        },
        {
          "type": "SYMBOL",
          "name": "pseudo_class_name"
        }
      ]
    },
    "pseudo_class_name": {
      "type": "PATTERN",
      "value": "[a-z][a-z0-9-]*"
    },
    "widget_selector": {
      "type": "PATTERN",
      "value": "[A-Z][a-zA-Z0-9_-]*"
    },
    "combinator": {
      "type": "STRING",
      "value": ">"
    },
    "rule_set": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "selectors"
        },
        {
          "type": "SYMBOL",
          "name": "block"
        }
      ]
    },
    "block": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "{"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "declaration"
              },
              {
                "type": "SYMBOL",
                "name": "rule_set"
              }
            ]
          }
        },
        {
          "type": "STRING",
          "value": "}"
        }
      ]
    },
    "declaration": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "property_name"
        },
        {
          "type": "STRING",
          "value": ":"
        },
        {
          "type": "REPEAT1",
          "content": {
            "type": "SYMBOL",
            "name": "_value"
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "important"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "STRING",
          "value": ";"
        }
      ]
    },
    "property_name": {
      "type": "PATTERN",
      "value": "[a-z][a-z0-9_-]*"
    },
    "important": {
      "type": "PATTERN",
      "value": "!\\s*important"
    },
    "_value": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "numeric_value"
        },
        {
          "type": "SYMBOL",
          "name": "color_value"
        },
        {
          "type": "SYMBOL",
          "name": "function_call"
        },
        {
          "type": "SYMBOL",
          "name": "variable"
        },
        {
          "type": "SYMBOL",
          "name": "keyword"
        }
      ]
    },
    "numeric_value": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "PATTERN",
                "value": "[-+]"
              },
              {
                "type": "BLANK"
              }
            ]
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "SEQ",
                "members": [
                  {
                    "type": "PATTERN",
                    "value": "[0-9]+"
                  },
                  {
                    "type": "CHOICE",
                    "members": [
                      {
                        "type": "SEQ",
                        "members": [
                          {
                            "type": "STRING",
                            "value": "."
                          },
                          {
                            "type": "PATTERN",
                            "value": "[0-9]+"
                          }
                        ]
                      },
                      {
                        "type": "BLANK"
                      }
                    ]
                  }
                ]
              },
              {
                "type": "SEQ",
                "members": [
                  {
                    "type": "STRING",
                    "value": "."
                  },
                  {
                    "type": "PATTERN",
                    "value": "[0-9]+"
                  }
                ]
              }
            ]
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "CHOICE",
                "members": [
                  {
                    "type": "STRING",
                    "value": "%"
                  },
                  {
                    "type": "STRING",
                    "value": "fr"
                  },
                  {
                    "type": "STRING",
                    "value": "h"
                  },
                  {
                    "type": "STRING",
                    "value": "vh"
                  },
                  {
                    "type": "STRING",
                    "value": "vw"
                  },
                  {
                    "type": "STRING",
                    "value": "w"
                  }
                ]
              },
              {
                "type": "BLANK"
              }
            ]
          }
        ]
      }
    },
    "color_value": {
      "type": "PATTERN",
      "value": "#[0-9a-fA-F]{3,8}"
    },
    "function_call": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "name",
          "content": {
            "type": "SYMBOL",
            "name": "keyword"
          }
        },
        {
          "type": "IMMEDIATE_TOKEN",
          "content": {
            "type": "STRING",
            "value": "("
          }
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SEQ",
            "members": [
              {
                "type": "SYMBOL",
                "name": "_value"
              },
              {
                "type": "CHOICE",
                "members": [
                  {
                    "type": "STRING",
                    "value": ","
                  },
                  {
                    "type": "BLANK"
                  }
                ]
              }
            ]
          }
        },
        {
          "type": "STRING",
          "value": ")"
        }
      ]
    },
    "variable": {
      "type": "PATTERN",
      "value": "\\$[a-zA-Z_-][a-zA-Z0-9_-]*"
    },
    "keyword": {
      "type": "PATTERN",
      "value": "[a-zA-Z][a-zA-Z0-9_-]*"
    },
    "variable_definition": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "variable"
        },
        {
          "type": "STRING",
          "value": ":"
        },
        {
          "type": "REPEAT1",
          "content": {
            "type": "SYMBOL",
            "name": "_value"
          }
        },
        {
          "type": "STRING",
          "value": ";"
        }
      ]
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "\\s"
    },
    {
      "type": "SYMBOL",
      "name": "comment_block"
    },
    {
      "type": "SYMBOL",
      "name": "comment_line"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}